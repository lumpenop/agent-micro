{
  "name": "agent-micro",
  "version": "1.2.0",
  "description": "Agent Micro — floating macropad for AI agent control",
  "main": "src/main.js",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "landing:build": "pnpm --filter @agent-micro/landing build",
    "landing:dev": "pnpm --filter @agent-micro/landing dev",
    "test:safe": "node scripts/smoke-features.js",
    "test:voice": "node scripts/test-local-voice.js",
    "test:assets": "node scripts/test-on-demand-assets.js",
    "test:rules": "node scripts/test-agent-rules.js",
    "test:usage": "node scripts/test-codex-usage.js",
    "test:routing": "node scripts/test-prompt-routing.js",
    "test:git-setup": "node scripts/test-git-setup.js",
    "test:coordinator": "node scripts/test-agent-coordinator.js",
    "test:coordinator:stress": "node scripts/test-agent-coordinator-stress.js",
    "test:controls": "node scripts/test-control-reliability.js",
    "test:providers": "node scripts/test-provider-compatibility.js",
    "test:providers:codex": "node scripts/test-codex-provider-probe.js",
    "ensure:whisper": "node scripts/ensure-whisper.js",
    "dist:mac": "electron-builder --mac dir --arm64",
    "dist:dmg": "electron-builder --mac dmg --arm64",
    "postinstall": "node scripts/ensure-electron.js && node scripts/ensure-tools.js"
  },
  "keywords": [
    "agent",
    "codex",
    "macropad",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.agentmicro.desktop",
    "productName": "Agent Micro",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      { "from": "assets/bin", "to": "bin" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "@openai/codex": "0.144.5"
  },
  "dependencies": {}
}
