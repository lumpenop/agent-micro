{
  "name": "agent-micro",
  "version": "1.0.0",
  "description": "Agent Micro — floating macropad for AI agent control",
  "main": "src/main.js",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "dev": "ELECTRON_RUN_AS_NODE= electron .",
    "test:safe": "node scripts/smoke-features.js",
    "test:voice": "node scripts/test-local-voice.js",
    "ensure:whisper": "node scripts/ensure-whisper.js",
    "dist:mac": "node scripts/ensure-whisper.js && electron-builder --mac dir --arm64",
    "dist:dmg": "node scripts/ensure-whisper.js && electron-builder --mac dmg --arm64",
    "postinstall": "node scripts/ensure-electron.js && node scripts/ensure-tools.js && node scripts/ensure-whisper.js"
  },
  "keywords": [
    "agent",
    "codex",
    "macropad",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.agentmicro.desktop",
    "productName": "Agent Micro",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "assets/bin", "to": "bin" },
      { "from": "assets/models/ggml-base.bin", "to": "models/ggml-base.bin" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Agent Micro uses the microphone for local speech-to-text commands."
      }
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@openai/codex": "^0.144.5",
    "@anthropic-ai/claude-code": "^2.1"
  }
}
